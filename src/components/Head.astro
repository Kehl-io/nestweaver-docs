---
import StarlightHead from '@astrojs/starlight/components/Head.astro';

const { entry, sidebar } = Astro.locals.starlightRoute;
const path = Astro.url.pathname;
const site = Astro.site?.origin || 'https://docs.nestweaver.kehl.io';

const segments = path.split('/').filter(Boolean);

const breadcrumbs = [{ name: 'Home', url: `${site}/` }];

if (segments.length > 1) {
  const sectionPath = `/${segments[0]}/`;
  // Only link a section if its landing page exists in the generated navigation.
  const section = sidebar.find(
    (item) =>
      item.type === 'group' &&
      item.entries.some((child) => child.type === 'link' && child.href === sectionPath),
  );
  if (section) {
    breadcrumbs.push({ name: section.label, url: `${site}${sectionPath}` });
  }
}

if (segments.length > 0 && entry.id !== '404') {
  breadcrumbs.push({ name: entry.data.title, url: `${site}${path}` });
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
};
---

<StarlightHead />
{entry.id === '404' && <meta name="robots" content="noindex" />}
{
  path !== '/' && entry.id !== '404' && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )
}
