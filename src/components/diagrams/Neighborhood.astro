---
interface Props {
  label: string;
  caption: string;
  seed: string;
}

const { label, caption, seed } = Astro.props;
const titleId = `nw-${label
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '')}`;
---

<figure class="nw-figure">
  <svg
    class="nw-diagram nw-neighborhood"
    viewBox="0 0 640 280"
    style="min-width: 640px"
    role="img"
    aria-labelledby={titleId}
  >
    <title id={titleId}>{label}</title>
    <defs>
      <marker
        id={`${titleId}-arrow`}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="nw-arrow"></path>
      </marker>
    </defs>
    <path d="M 320 78 L 320 102" class="nw-edge" marker-end={`url(#${titleId}-arrow)`}></path>
    <path d="M 246 138 L 210 138" class="nw-edge" marker-end={`url(#${titleId}-arrow)`}></path>
    <path d="M 394 162 L 430 162" class="nw-edge" marker-end={`url(#${titleId}-arrow)`}></path>
    <path d="M 320 214 L 320 188" class="nw-edge" marker-end={`url(#${titleId}-arrow)`}></path>
    <rect class="nw-node" x="230" y="16" width="180" height="62" rx="4"></rect>
    <text class="nw-node-title" x="320" y="42" text-anchor="middle">Callers</text>
    <text class="nw-node-detail" x="320" y="60" text-anchor="middle">who reaches the seed</text>
    <rect class="nw-node" x="24" y="118" width="180" height="62" rx="4"></rect>
    <text class="nw-node-title" x="114" y="144" text-anchor="middle">Types</text>
    <text class="nw-node-detail" x="114" y="162" text-anchor="middle">what it belongs to</text>
    <rect class="nw-node nw-node-accent" x="246" y="108" width="148" height="72" rx="4"></rect>
    <text class="nw-node-title nw-on-accent" x="320" y="140" text-anchor="middle">{seed}</text>
    <text class="nw-node-detail nw-on-accent" x="320" y="158" text-anchor="middle">the seed</text>
    <rect class="nw-node" x="436" y="118" width="180" height="62" rx="4"></rect>
    <text class="nw-node-title" x="526" y="144" text-anchor="middle">Callees</text>
    <text class="nw-node-detail" x="526" y="162" text-anchor="middle">what the seed calls</text>
    <rect class="nw-node" x="230" y="214" width="180" height="52" rx="4"></rect>
    <text class="nw-node-title" x="320" y="245" text-anchor="middle">Tests that call it</text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
